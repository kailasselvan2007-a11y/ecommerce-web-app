# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/shopease or MongoDB Atlas URI)
MONGODB_URI="mongodb://localhost:27017/shopease"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="your_jwt_secret_key_change_in_production"

# PORT: Port on which the Express backend server listens
PORT=3000

# GEMINI_API_KEY: Optional
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
